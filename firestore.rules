rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── ROOMS ──────────────────────────────────────────────
    // Anyone can create/join/read rooms (multiplayer needs this)
    match /rooms/{roomId} {
      allow read, write: if true;

      match /actions/{actionId} {
        allow read, write: if true;
      }

      // Emoji reactions (ReactionBar) and voice clips (VoiceBroadcastButton).
      // Both were missing here and so were denied by the catch-all below —
      // the writes failed silently. Voice clips are base64 audio; the size
      // cap matches the client's own MAX_BASE64_BYTES safety net.
      match /reactions/{playerId} {
        allow read, write: if true;
      }

      match /voice/{playerId} {
        allow read, delete: if true;
        allow create, update: if request.resource.data.url.size() <= 700000;
      }
    }

    // ── PROFILES ───────────────────────────────────────────
    // Device can read/write its own profile only
    match /profiles/{profileId} {
      allow read, write: if true;

      match /stats/{statId} {
        allow read, write: if true;
      }
    }

    // ── QUESTION STATS ─────────────────────────────────────
    // Anyone can read and write (tracking question frequency)
    match /question_stats/{docId} {
      allow read, write: if true;
    }

    // ── ANALYTICS ──────────────────────────────────────────
    // Anyone can write (fire and forget from client)
    // No client reads needed — dashboard uses REST API
    match /analytics_events/{docId} {
      allow read, write: if true;
    }

    match /analytics_devices/{docId} {
      allow read, write: if true;
    }

    match /analytics_daily/{docId} {
      allow read, write: if true;
    }

    // ── DC WORD STATS ───────────────────────────────────────
    // Dashboard reads word stats; clients write on every word shown/result
    match /dc_word_stats/{docId} {
      allow write: if true;
      allow read: if true;
    }

    // ── DC SESSION STATS ────────────────────────────────────
    // Dashboard reads via REST API; clients write (aggregate daily counters)
    match /dc_session_stats/{docId} {
      allow write: if true;
      allow read: if true;
    }

    // ── EVERYTHING ELSE ────────────────────────────────────
    // Deny by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
